APP_NAME="Asklepios ERP"
APP_ENV=local
APP_KEY=base64:AAUFGJUQxsZ03u4lNryPoKSGbE8orNqBtZ/CwKzVcaE=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
L5_SWAGGER_GENERATE_ALWAYS=true

APP_MAINTENANCE_DRIVER=file

DEFAULT_HOSPITAL_ID=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# MOTEUR OCTANE
# ==========================================
OCTANE_SERVER=roadrunner

# ==========================================
# 1. BASE DE DONNÉES SYSTÈME (Routeur SaaS)
# ==========================================
DB_CONNECTION=system
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asklepios_system
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# 2. BASE DE DONNÉES TENANT (Données Métier)
# ==========================================
DB_TENANT_HOST=127.0.0.1
DB_TENANT_PORT=3306
DB_TENANT_DATABASE=asklepios_dev_tenant
DB_TENANT_USERNAME=root
DB_TENANT_PASSWORD=

# ==========================================
# SESSIONS, CACHES & FILES D'ATTENTE
# ==========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ==========================================
# SERVICES TIERS (Memcached / Redis)
# ==========================================
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# EMAILS
# ==========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@asklepios.cm"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# VITE (Frontend)
# ==========================================
VITE_APP_NAME="${APP_NAME}"